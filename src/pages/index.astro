---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SystemsLabCard from '../components/SystemsLabCard.astro';
import AboutBlock from '../components/AboutBlock.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Icon from '../components/Icon.astro';
import {
  getFeaturedProjects,
  getSystemsLabEntries,
  SYSTEMS_LAB_PLACEHOLDERS,
} from '../lib/content';

const [featured, systems] = await Promise.all([
  getFeaturedProjects(),
  getSystemsLabEntries(),
]);

// En fazla 4 featured kart — hepsi gerçek proje. Yoksa bölüm hiç çıkmaz
// (yer tutucu / "work in progress" görüntüsü yok).
const featuredCards = featured.slice(0, 4);
const systemsPreview = systems.length > 0 ? systems.slice(0, 4) : [];
---

<BaseLayout padTop={false}>
  <div class="flow">
    <Hero />

    <!-- ABOUT (kısa) — gerçek içerik olduğu için hero'dan hemen sonra -->
    <AboutBlock compact />

    <!-- FEATURED PROJECTS — sadece gerçek featured proje varsa -->
    {
      featuredCards.length > 0 && (
        <section aria-labelledby="featured-title">
          <div class="container">
            <SectionHeading kicker="Selected Work" title="Featured projects" id="featured-title" />
            <div class="featured-rail">
              {featuredCards.map((p) => <ProjectCard project={p} />)}
            </div>
            <a class="arrow-link section-more" href="/work">
              All work <Icon name="arrow" size={16} />
            </a>
          </div>
        </section>
      )
    }

    <!-- SYSTEMS LAB -->
    <section aria-labelledby="lab-title">
      <div class="container">
        <SectionHeading kicker="Systems Lab" title="Gameplay systems, broken down" id="lab-title">
          <p>Focused write-ups of individual mechanics — movement, interaction, combat, UI &amp; input.</p>
        </SectionHeading>
        <div class="systems-rail">
          {
            systemsPreview.length > 0
              ? systemsPreview.map((e) => <SystemsLabCard entry={e} />)
              : SYSTEMS_LAB_PLACEHOLDERS.map((ph) => (
                  <SystemsLabCard placeholderTitle={ph.title} />
                ))
          }
        </div>
        <a class="arrow-link section-more" href="/systems-lab">
          Open Systems Lab <Icon name="arrow" size={16} />
        </a>
      </div>
    </section>

    <!-- CONTACT -->
    <ContactBlock />
  </div>
</BaseLayout>

<style>
  /*
   * Featured / Systems Lab şeritleri — her zaman yatay kaydırmalı.
   * Kartlar `flex-shrink: 0` olduğu için sığdıkları sürece satıra
   * yayılır (grow); sığmadıklarında (çok kart ya da dar ekran)
   * genişlikte sabit kalıp taşar → doğal olarak "yana kaydır"a döner.
   * Böylece 1 kart da, 4 kart da aynı bileşenle doğru davranır.
   */
  .featured-rail,
  .systems-rail {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-m);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-xs);
    /* kartların viewport kenarına doğru taştığını hissettir */
    margin-inline: calc(-1 * var(--space-xs));
    padding: var(--space-3xs) var(--space-xs) var(--space-s);
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  .featured-rail > :global(.pcard) {
    flex: 1 0 min(82%, 21rem);
    max-width: 24rem;
    scroll-snap-align: start;
  }
  .systems-rail > :global(.scard) {
    flex: 1 0 min(58%, 13rem);
    max-width: 16rem;
    scroll-snap-align: start;
  }
  .featured-rail::-webkit-scrollbar,
  .systems-rail::-webkit-scrollbar {
    height: 6px;
  }
  .featured-rail::-webkit-scrollbar-thumb,
  .systems-rail::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: var(--radius-pill);
  }

  .section-more {
    display: inline-flex;
    margin-top: var(--space-l);
  }

  @media (min-width: 40rem) {
    .featured-rail,
    .systems-rail {
      gap: var(--space-l);
    }
    .featured-rail > :global(.pcard) {
      flex-basis: 20rem;
      max-width: 26rem;
    }
    .systems-rail > :global(.scard) {
      flex-basis: 13rem;
      max-width: 17rem;
    }
  }

  @media (min-width: 64rem) {
    .featured-rail,
    .systems-rail {
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-rail,
    .systems-rail {
      scroll-behavior: smooth;
    }
  }
</style>
