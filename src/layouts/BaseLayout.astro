---
/**
 * Tüm sayfaların ortak iskeleti.
 * Stil yükleme sırası: tokens (değişkenler) -> global (temel) -> component'ler.
 */
import '../styles/tokens.css';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/content';
import { thumbUrl } from '../lib/image';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Header'ı gizle (ör. hero'nun kendi üst alanını yönettiği durumlar) */
  padTop?: boolean;
}

const settings = await getSiteSettings();

const {
  title,
  description = settings.siteDescription,
  image,
  noindex = false,
  padTop = true,
} = Astro.props;

const fullTitle = title ? `${title} · ${settings.siteTitle}` : `${settings.siteTitle} · Game Developer`;
const ogImage = image ?? thumbUrl(settings.ogImage, 1200, 630) ?? undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={fullTitle}
      description={description}
      image={ogImage}
      noindex={noindex}
    />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a href="#main" class="skip-link">İçeriğe geç</a>
    <Header />
    <main id="main" class:list={['main', { 'main--pad': padTop }]}>
      <slot />
    </main>
    <Footer />

    <style>
      /* İç sayfaların başlığı header'ın hemen altında başlasın */
      .main--pad {
        padding-top: clamp(1.5rem, 0.9rem + 2.2vw, 2.75rem);
      }

      /* Üstte ince okuma-ilerlemesi çubuğu */
      .scroll-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: calc(var(--z-header) + 1);
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        opacity: 0.7;
        pointer-events: none;
      }

      /* Scroll ile ortaya çıkış */
      :global([data-reveal]) {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
          transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }
      :global([data-reveal].is-in) {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        :global([data-reveal]) {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .scroll-progress {
          display: none;
        }
      }
    </style>

    <script>
      // --- Scroll ilerleme çubuğu ---
      const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (bar) {
        let ticking = false;
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
          ticking = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        update();
      }

      // --- Scroll-reveal (bölüm ve kart seviyesinde) ---
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const blocks = document.querySelectorAll<HTMLElement>(
        'main section:not(.hero), main .page-head, main article.cs',
      );
      if (!reduce && 'IntersectionObserver' in window && blocks.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        blocks.forEach((b) => {
          // Ekranda hâlihazırda görünen içeriği gizleme (flaş olmasın) —
          // sadece kıvrımın altındakiler kayarken belirsin.
          if (b.getBoundingClientRect().top > window.innerHeight * 0.85) {
            b.setAttribute('data-reveal', '');
            io.observe(b);
          }
        });
      }
    </script>
  </body>
</html>
