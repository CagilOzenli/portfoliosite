---
/**
 * Uzun düz-metin alanlarını (bio, technicalChallenges, ...) okunur biçimde
 * gösterir. CMS'te bu alanlar çok satırlı metin; boş satır = yeni paragraf,
 * tek satır sonu korunur. Metin olduğu gibi basılır (HTML enjeksiyonu yok).
 */
interface Props {
  text?: string | null;
  class?: string;
}
const { text, class: className } = Astro.props;

const paragraphs = (text ?? '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
---

{
  paragraphs.length > 0 && (
    <div class:list={['prose', className]}>
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  )
}

<style>
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    /* Referans: uzun prose'da DM Sans — monospace baskınlığına karşı
       hafif humanist kontrast, seyrek kullanım. */
    font-family: var(--font-sans);
    color: var(--text);
    max-width: 62ch;
  }
  .prose :global(p) {
    line-height: var(--leading-normal);
    white-space: pre-line; /* CMS'teki tek satır sonlarını korur */
  }
</style>
