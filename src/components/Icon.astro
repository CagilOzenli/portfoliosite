---
/**
 * Tek dosyada küçük ikon seti. Kullanım: <Icon name="arrow" />
 * Çizgi ikonlar `currentColor` ile boyanır (bulunduğu metnin rengini alır).
 * `title` verilirse erişilebilir (role="img" + <title>), yoksa dekoratif.
 */
interface Props {
  name:
    | 'arrow'
    | 'external'
    | 'mail'
    | 'github'
    | 'linkedin'
    | 'play'
    | 'menu'
    | 'close'
    | 'download'
    | 'gamepad';
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 20, class: className, title } = Astro.props;

const FILLED = new Set<Props['name']>(['github', 'linkedin', 'play']);
const filled = FILLED.has(name);

const SHAPES: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15M13 5l7 7-7 7"/>',
  external:
    '<path d="M14 4h6v6M20 4l-8.5 8.5M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  download: '<path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 21h14"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  play: '<path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14z"/>',
  github:
    '<path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/>',
  linkedin:
    '<path d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM3.2 8.5h3.5v12H3.2v-12zM9 8.5h3.35v1.64h.05c.47-.85 1.6-1.75 3.3-1.75 3.53 0 4.18 2.24 4.18 5.15v6.96h-3.5v-6.17c0-1.47-.03-3.36-2.06-3.36-2.06 0-2.38 1.6-2.38 3.25v6.28H9v-12z"/>',
  gamepad:
    '<path d="M6.6 8.6h1.8M7.5 7.7v1.8" stroke-linecap="round"/><circle cx="15.6" cy="8" r="0.7" fill="currentColor" stroke="none"/><circle cx="17.4" cy="9.8" r="0.7" fill="currentColor" stroke="none"/><path d="M9.5 7h5c2.5 0 3.75 0 4.7.9.9.87 1.05 2.2 1.35 4.86.24 2.12.36 3.18-.28 3.9-.64.7-1.7.7-3.82.7-.9 0-1.35 0-1.72-.2-.37-.2-.62-.57-1.12-1.3l-.4-.6c-.3-.44-.45-.66-.67-.78a1.5 1.5 0 0 0-.7-.18h-1.6c-.26 0-.5.06-.7.18-.22.12-.37.34-.67.78l-.4.6c-.5.73-.75 1.1-1.12 1.3-.37.2-.82.2-1.72.2-2.12 0-3.18 0-3.82-.7-.64-.72-.52-1.78-.28-3.9.3-2.66.45-4 1.35-4.86C5.75 7 7 7 9.5 7z"/>',
};

const titleTag = title ? `<title>${title.replace(/[<>&]/g, '')}</title>` : '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  set:html={titleTag + SHAPES[name]}
/>
