---
/**
 * DENEY (terminal) — Hero görseli: çerçeveli "engine viewport" içinde
 * ASCII Space Invaders.
 *   - Ambient: kendi kendine oynanır (düşük opaklık, arka plan).
 *   - Easter egg: panele tıkla/dokun -> OYNANABİLİR. Panel modal olur,
 *     ok tuşları + boşluk (mobilde ekran butonları), 3 can, skor,
 *     game over + tekrar, yüksek skor localStorage'da. ESC ile çık.
 * reduced-motion: ambient durur ama kullanıcı "play"e basarsa oyun çalışır.
 */
---

<div class="si" data-si-root>
  <div class="si__screen" data-screen tabindex="-1">
    <div class="si__bar">
      <em>viewport</em>
      <button type="button" class="si__play" data-play aria-label="Play the mini-game">▶&nbsp;play</button>
      <b data-wave>wave 1</b>
    </div>

    <pre class="si__grid" data-si></pre>

    <div class="si__over" data-over hidden>
      <p class="si__over-t" data-over-title>game over</p>
      <p class="si__over-s" data-over-score></p>
      <p class="si__over-h" data-over-hint>press <kbd>space</kbd> to retry · <kbd>esc</kbd> to exit</p>
    </div>

    <div class="si__pad" data-pad hidden aria-hidden="true">
      <button type="button" data-btn="left" aria-label="left">◄</button>
      <button type="button" data-btn="fire" aria-label="fire">▲</button>
      <button type="button" data-btn="right" aria-label="right">►</button>
    </div>

    <button type="button" class="si__close" data-close aria-label="Close game" hidden>×</button>
  </div>

  <div class="si__hud" data-hud>
    <span><b>enemies</b> <i data-enemies>0</i></span>
    <span><b>score</b> <i data-score>0</i></span>
    <span class="si__stat"><i></i> <span data-statlabel>simulating</span></span>
  </div>

  <div class="si__backdrop" data-backdrop hidden></div>
</div>

<style>
  .si {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  /* component display kuralları [hidden]'ı ezmesin */
  .si [hidden] {
    display: none !important;
  }

  .si__screen {
    position: absolute;
    left: 50%;
    top: var(--space-m);
    transform: translateX(-50%);
    width: min(92vw, 440px);
    height: clamp(150px, 42vw, 200px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--brand-void) 55%, transparent);
    overflow: hidden;
    opacity: 0.95;
    outline: none;
    cursor: pointer;
    pointer-events: auto;
    transition: box-shadow var(--transition), border-color var(--transition);
  }
  .si__screen:hover,
  .si__screen:focus-visible {
    border-color: var(--border-strong);
  }

  .si__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.55rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-faint);
    background: color-mix(in srgb, var(--brand-steel) 40%, transparent);
    z-index: 2;
  }
  .si__bar em { font-style: normal; }
  .si__bar b { font-weight: var(--weight-normal); color: var(--accent-amber); margin-left: auto; }
  .si__play {
    background: none;
    border: 0;
    padding: 0.1rem 0.3rem;
    font: inherit;
    color: var(--accent);
    cursor: pointer;
    border-radius: 3px;
  }
  .si__play:hover { color: var(--link-hover); background: color-mix(in srgb, var(--accent) 12%, transparent); }

  .si__grid {
    position: absolute;
    left: 50%;
    top: calc(50% + 0.8rem);
    transform: translate(-50%, -50%) scale(var(--k, 1));
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.16;
    letter-spacing: 0;
    white-space: pre;
    color: var(--text);
  }
  .si__grid :global(.e) { color: var(--accent); }
  .si__grid :global(.e2) { color: var(--accent-strong); }
  .si__grid :global(.gun) { color: var(--accent-amber); }
  .si__grid :global(.shot) { color: var(--text-strong); }
  .si__grid :global(.bomb) { color: var(--brand-fault); }
  .si__grid :global(.hit) { color: var(--accent-amber); }

  /* game over katmanı */
  .si__over {
    position: absolute;
    inset: 1.6rem 0 0 0;
    z-index: 3;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--brand-void) 78%, transparent);
    font-family: var(--font-mono);
  }
  .si__over-t { color: var(--brand-fault); font-size: 1rem; }
  .si__over-s { color: var(--text); font-size: 0.85rem; }
  .si__over-h { color: var(--text-faint); font-size: 0.68rem; }
  .si__over kbd {
    font: inherit;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    padding: 0 0.25rem;
  }

  /* mobil kontrol butonları */
  .si__pad {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem;
  }
  .si__pad button {
    width: 3rem;
    height: 2.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--brand-steel) 70%, transparent);
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }
  .si__pad button:active {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  .si__close {
    position: absolute;
    top: 0.2rem;
    right: 0.35rem;
    z-index: 4;
    background: none;
    border: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .si__close:hover { color: var(--text-strong); }

  .si__hud {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .si__hud b {
    color: var(--accent-amber);
    display: inline-block;
    width: 3.6rem;
    font-weight: var(--weight-normal);
  }
  .si__hud i { font-style: normal; color: var(--text-muted); }
  .si__stat {
    margin-top: 0.25rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--border);
    width: 9rem;
  }
  .si__stat > i {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-strong);
    margin-right: 0.4rem;
    vertical-align: middle;
  }
  @media (prefers-reduced-motion: no-preference) {
    .si__stat > i { animation: si-blink 1s steps(1, end) infinite; }
  }
  @keyframes si-blink { 50% { opacity: 0.15; } }

  .si__backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--brand-void) 92%, transparent);
    backdrop-filter: blur(2px);
    pointer-events: auto;
    cursor: pointer;
  }

  /* --- OYUN MODU: panel modal olur --- */
  .si--playing {
    z-index: var(--z-nav-overlay);
  }
  .si--playing .si__backdrop {
    z-index: 1;
  }
  .si--playing .si__screen {
    position: fixed;
    inset: 0;
    margin: auto;
    transform: none;
    z-index: 2;
    width: min(94vw, 620px);
    height: min(80vh, 520px);
    opacity: 1;
    cursor: default;
    border-color: var(--border-strong);
    box-shadow: 0 0 0 1px var(--border-strong), 0 30px 80px -20px #000;
  }
  .si--playing .si__grid { color: color-mix(in srgb, var(--text) 88%, var(--brand-void)); }
  .si--playing .si__close { display: block; }
  .si--playing .si__hud { display: none; }
  .si--playing .si__play { display: none; }

  /* masaüstü ambient: paneli içerik kolonunun sağ kenarına hizala */
  @media (min-width: 62rem) {
    .si:not(.si--playing) .si__screen {
      left: auto;
      top: 50%;
      right: calc(50% - var(--container) / 2 - 0.5rem);
      transform: translateY(-50%);
      width: min(34vw, 380px);
      height: min(30vw, 330px);
      opacity: 0.85;
    }
  }
  @media (max-width: 48rem) {
    .si:not(.si--playing) .si__hud { display: none; }
  }
  @media (pointer: fine) {
    .si--playing .si__pad { display: none !important; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-si-root]');
  const el = document.querySelector<HTMLPreElement>('[data-si]');
  const screen = document.querySelector<HTMLElement>('[data-screen]');

  if (root && el && screen) {
    const grid: HTMLPreElement = el;
    const rootEl: HTMLElement = root;
    const screenEl: HTMLElement = screen;
    const waveOut = document.querySelector<HTMLElement>('[data-wave]');
    const enemiesOut = document.querySelector<HTMLElement>('[data-enemies]');
    const scoreOut = document.querySelector<HTMLElement>('[data-score]');
    const statLabel = document.querySelector<HTMLElement>('[data-statlabel]');
    const over = document.querySelector<HTMLElement>('[data-over]');
    const overTitle = document.querySelector<HTMLElement>('[data-over-title]');
    const overScore = document.querySelector<HTMLElement>('[data-over-score]');
    const pad = document.querySelector<HTMLElement>('[data-pad]');
    const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
    const closeBtn = document.querySelector<HTMLElement>('[data-close]');
    const playBtn = document.querySelector<HTMLElement>('[data-play]');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const COLS = 26;
    const ROWS = 14;
    const GUN_ROW = ROWS - 1;
    const EN_COLS = 5;
    const EN_ROWS = 3;
    const GAP_X = 4;
    const GAP_Y = 2;
    const FRAMES = [
      ['/', 'M', '\\'],
      ['\\', 'M', '/'],
    ];
    const GUN = ['/', '^', '\\'];
    const HS_KEY = 'si-highscore';

    type Mode = 'ambient' | 'play' | 'over';
    let mode: Mode = 'ambient';
    const isOver = () => mode === 'over';

    let alive: boolean[][];
    let fleet: { x: number; y: number; dir: number };
    const gun = { x: (COLS >> 1) - 1 };
    let shots: { x: number; y: number }[] = [];
    let bombs: { x: number; y: number }[] = [];
    let hits: { x: number; y: number; t: number }[] = [];
    let wave = 1;
    let score = 0;
    let lives = 3;
    let tick = 0;
    let cooldown = 0;
    let flash = 0;
    const input = { left: false, right: false, fire: false };
    let highScore = 0;
    try { highScore = Number(localStorage.getItem(HS_KEY)) || 0; } catch {}

    function spawn() {
      alive = Array.from({ length: EN_ROWS }, () => Array(EN_COLS).fill(true));
      fleet = { x: 2, y: 1, dir: 1 };
      shots = [];
      bombs = [];
    }
    function resetGame() {
      spawn();
      wave = 1;
      score = 0;
      lives = 3;
      gun.x = (COLS >> 1) - 1;
    }
    spawn();

    const enemyX = (c: number) => fleet.x + c * GAP_X;
    const enemyY = (r: number) => fleet.y + r * GAP_Y;
    const countAlive = () => alive.flat().filter(Boolean).length;

    function bounds() {
      let min = Infinity, max = -Infinity, maxY = -Infinity;
      for (let r = 0; r < EN_ROWS; r++)
        for (let c = 0; c < EN_COLS; c++)
          if (alive[r][c]) {
            min = Math.min(min, enemyX(c));
            max = Math.max(max, enemyX(c) + 2);
            maxY = Math.max(maxY, enemyY(r));
          }
      return { min, max, maxY };
    }

    function tryFire() {
      if (cooldown === 0 && shots.length < (mode === 'play' ? 3 : 2)) {
        shots.push({ x: gun.x + 1, y: GUN_ROW - 1 });
        cooldown = mode === 'play' ? 2 : 3;
      }
    }

    function loseLife() {
      lives--;
      flash = 4;
      bombs = [];
      if (lives <= 0) endGame();
    }

    function endGame() {
      mode = 'over';
      if (score > highScore) {
        highScore = score;
        try { localStorage.setItem(HS_KEY, String(score)); } catch {}
      }
      if (overTitle) overTitle.textContent = 'game over';
      if (overScore) overScore.textContent = `score ${score}  ·  best ${highScore}`;
      over?.removeAttribute('hidden');
    }

    function step() {
      tick++;
      if (cooldown > 0) cooldown--;
      if (flash > 0) flash--;

      const n = countAlive();
      if (n === 0) {
        wave++;
        score += 100;
        spawn();
        return;
      }

      const reachedBottom = bounds().maxY >= GUN_ROW - 1;
      if (reachedBottom) {
        if (mode === 'play') {
          loseLife();
          if (isOver()) return;
          spawn();
        } else {
          spawn();
          return;
        }
      }

      // fleet
      const moveEvery = Math.max(1, Math.round(n / 5) + (mode === 'play' ? 1 : 0));
      if (tick % moveEvery === 0) {
        const b = bounds();
        if ((fleet.dir > 0 && b.max >= COLS - 1) || (fleet.dir < 0 && b.min <= 0)) {
          fleet.dir *= -1;
          fleet.y += 1;
        } else {
          fleet.x += fleet.dir;
        }
      }

      // cannon
      if (mode === 'play') {
        if (input.left) gun.x--;
        if (input.right) gun.x++;
        gun.x = Math.max(0, Math.min(COLS - 3, gun.x));
        if (input.fire) tryFire();
      } else {
        let targetX = gun.x;
        let best = Infinity;
        for (let c = 0; c < EN_COLS; c++)
          for (let r = EN_ROWS - 1; r >= 0; r--)
            if (alive[r][c]) {
              const ex = enemyX(c) + 1;
              if (Math.abs(ex - (gun.x + 1)) < best) {
                best = Math.abs(ex - (gun.x + 1));
                targetX = ex - 1;
              }
              break;
            }
        gun.x += Math.sign(targetX - gun.x);
        gun.x = Math.max(0, Math.min(COLS - 3, gun.x));
        if (best < 2) tryFire();
      }

      // shots
      shots = shots.filter((s) => {
        s.y -= 1;
        if (s.y < 0) return false;
        for (let r = 0; r < EN_ROWS; r++)
          for (let c = 0; c < EN_COLS; c++)
            if (alive[r][c]) {
              const ex = enemyX(c), ey = enemyY(r);
              if (s.y === ey && s.x >= ex && s.x <= ex + 2) {
                alive[r][c] = false;
                score += 20;
                hits.push({ x: ex + 1, y: ey, t: 3 });
                return false;
              }
            }
        return true;
      });

      // bombs
      const bombChance = mode === 'play' ? 0.14 : 0.06;
      if (Math.random() < bombChance && bombs.length < (mode === 'play' ? 4 : 2)) {
        const cols: number[] = [];
        for (let c = 0; c < EN_COLS; c++) if (alive.some((row) => row[c])) cols.push(c);
        if (cols.length) {
          const c = cols[(Math.random() * cols.length) | 0];
          let br = 0;
          for (let r = EN_ROWS - 1; r >= 0; r--) if (alive[r][c]) { br = r; break; }
          bombs.push({ x: enemyX(c) + 1, y: enemyY(br) + 1 });
        }
      }
      bombs = bombs.filter((b) => {
        b.y += 1;
        if (mode === 'play' && b.y >= GUN_ROW && b.x >= gun.x && b.x <= gun.x + 2) {
          loseLife();
          return false;
        }
        return b.y < ROWS;
      });

      hits = hits.filter((h) => --h.t > 0);
    }

    function render() {
      const buf: string[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(' '));
      const cls: (string | null)[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(null));
      const put = (r: number, c: number, ch: string, k: string) => {
        if (r < 0 || c < 0 || r >= ROWS || c >= COLS) return;
        buf[r][c] = ch;
        cls[r][c] = k;
      };

      const shape = FRAMES[tick % 2];
      for (let r = 0; r < EN_ROWS; r++)
        for (let c = 0; c < EN_COLS; c++) {
          if (!alive[r][c]) continue;
          const ex = enemyX(c), ey = enemyY(r);
          const kind = r === 0 ? 'e2' : 'e';
          for (let i = 0; i < 3; i++) put(ey, ex + i, shape[i], kind);
        }
      for (const h of hits) {
        put(h.y, h.x - 1, '*', 'hit');
        put(h.y, h.x + 1, '*', 'hit');
        put(h.y, h.x, '+', 'hit');
      }
      for (const b of bombs) put(b.y, b.x, tick % 2 ? '¦' : ':', 'bomb');
      for (const s of shots) put(s.y, s.x, '|', 'shot');
      if (flash % 2 === 0) for (let i = 0; i < 3; i++) put(GUN_ROW, gun.x + i, GUN[i], 'gun');

      let html = '';
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const k = cls[r][c];
          html += k ? `<span class="${k}">${buf[r][c]}</span>` : buf[r][c];
        }
        html += '\n';
      }
      grid.innerHTML = html;

      if (waveOut) waveOut.textContent = mode === 'play' ? `wave ${wave} · ♥${Math.max(lives, 0)}` : `wave ${wave}`;
      if (enemiesOut) enemiesOut.textContent = String(countAlive());
      if (scoreOut) scoreOut.textContent = String(score);
      if (statLabel) statLabel.textContent = mode === 'ambient' ? 'simulating' : 'live';
    }

    // --- fit ---
    function fit() {
      grid.style.setProperty('--k', '1');
      const availW = screenEl.clientWidth - 14;
      const availH = screenEl.clientHeight - 30;
      const k = Math.min(availW / grid.offsetWidth, availH / grid.offsetHeight, 2.2);
      grid.style.setProperty('--k', String(Math.max(0.4, k)));
    }
    let fitTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(fitTimer);
      fitTimer = window.setTimeout(fit, 150);
    });

    // --- mod geçişleri ---
    function enterPlay() {
      if (mode !== 'ambient') return;
      mode = 'play';
      resetGame();
      rootEl.classList.add('si--playing');
      backdrop?.removeAttribute('hidden');
      closeBtn?.removeAttribute('hidden');
      over?.setAttribute('hidden', '');
      pad?.removeAttribute('hidden');
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(() => { fit(); screenEl.focus(); });
    }
    function exitPlay() {
      mode = 'ambient';
      rootEl.classList.remove('si--playing');
      backdrop?.setAttribute('hidden', '');
      closeBtn?.setAttribute('hidden', '');
      pad?.setAttribute('hidden', '');
      over?.setAttribute('hidden', '');
      document.documentElement.style.overflow = '';
      spawn();
      requestAnimationFrame(fit);
    }
    function retry() {
      mode = 'play';
      resetGame();
      over?.setAttribute('hidden', '');
    }

    screenEl.addEventListener('click', (e) => {
      if (mode === 'ambient' && !(e.target as HTMLElement).closest('[data-close]')) enterPlay();
    });
    playBtn?.addEventListener('click', (e) => { e.stopPropagation(); enterPlay(); });
    closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); exitPlay(); });
    backdrop?.addEventListener('click', exitPlay);

    // klavye
    const KEYMAP: Record<string, 'left' | 'right' | 'fire'> = {
      ArrowLeft: 'left', a: 'left', A: 'left',
      ArrowRight: 'right', d: 'right', D: 'right',
      ArrowUp: 'fire', ' ': 'fire', w: 'fire', W: 'fire',
    };
    window.addEventListener('keydown', (e) => {
      if (mode === 'ambient') return;
      if (e.key === 'Escape') { exitPlay(); return; }
      if (mode === 'over' && (e.key === ' ' || e.key === 'Enter')) { e.preventDefault(); retry(); return; }
      const a = KEYMAP[e.key];
      if (a) { input[a] = true; e.preventDefault(); }
    });
    window.addEventListener('keyup', (e) => {
      const a = KEYMAP[e.key];
      if (a) input[a] = false;
    });

    // dokunmatik pad
    pad?.querySelectorAll<HTMLElement>('[data-btn]').forEach((btn) => {
      const key = btn.dataset.btn as 'left' | 'right' | 'fire';
      const on = (v: boolean) => (e: Event) => {
        e.preventDefault();
        if (mode === 'over' && v) { retry(); return; }
        input[key] = v;
      };
      btn.addEventListener('pointerdown', on(true));
      btn.addEventListener('pointerup', on(false));
      btn.addEventListener('pointerleave', on(false));
      btn.addEventListener('pointercancel', on(false));
    });
    over?.addEventListener('click', () => { if (mode === 'over') retry(); });

    // --- döngü ---
    render();
    fit();
    document.fonts?.ready.then(fit);

    let last = 0;
    function loop(ts: number) {
      const interval = mode === 'ambient' ? 140 : 55;
      if (ts - last > interval) {
        last = ts;
        if (mode !== 'over') step();
        render();
      }
      if (!document.hidden) requestAnimationFrame(loop);
      else setTimeout(() => requestAnimationFrame(loop), 500);
    }
    if (!reduce) requestAnimationFrame(loop);
    else {
      // reduced-motion: ambient statik; ama oynanınca döngüyü başlat
      screenEl.addEventListener('click', function once() {
        screenEl.removeEventListener('click', once);
        requestAnimationFrame(loop);
      });
    }
  }
</script>
