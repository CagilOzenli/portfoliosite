---
/**
 * DENEY (terminal) — Hero'nun TAMAMININ arkasında çalışan ASCII Space Invaders.
 *   - Ambient: tüm hero'yu kaplar, çok düşük opaklık, tıklanamaz (metin önde).
 *   - Easter egg: sayfadaki [data-si-play] öğesine tıkla ya da "P" tuşuna bas
 *     -> ortada modal oyun (klavye + dokunmatik, 3 can, skor, dalga, game over
 *     + tekrar, yüksek skor localStorage). ESC / kapat / arka plan -> ambient.
 * reduced-motion: ambient durur; kullanıcı başlatırsa oyun çalışır.
 */
---

<div class="si" data-si-root aria-hidden="true">
  <div class="si__stage" data-stage>
    <pre class="si__grid" data-si></pre>

    <div class="si__hb" data-hb hidden>
      <span data-wave>wave 1</span>
      <button type="button" class="si__x" data-close aria-label="Close game">esc ×</button>
    </div>

    <div class="si__over" data-over hidden>
      <p class="si__over-t" data-over-title>game over</p>
      <p class="si__over-s" data-over-score></p>
      <p class="si__over-h">press <kbd>space</kbd> — retry · <kbd>esc</kbd> — exit</p>
    </div>

    <div class="si__pad" data-pad hidden>
      <button type="button" data-btn="left" aria-label="left">◄</button>
      <button type="button" data-btn="fire" aria-label="fire">▲</button>
      <button type="button" data-btn="right" aria-label="right">►</button>
    </div>
  </div>

  <p class="si__hud" data-hud><span data-statdot>●</span> <span data-statlabel>simulating</span> · <span data-score>0</span></p>
  <div class="si__backdrop" data-backdrop hidden></div>
</div>

<style>
  .si {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .si [hidden] {
    display: none !important;
  }

  /* --- AMBIENT: hero'yu kaplayan soluk arka plan --- */
  .si__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .si__grid {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.18;
    letter-spacing: 0;
    white-space: pre;
    color: var(--text);
    opacity: 0.26;
    transform: scale(var(--k, 1));
    -webkit-mask-image: radial-gradient(135% 105% at 50% 44%, #000 52%, transparent 100%);
    mask-image: radial-gradient(135% 105% at 50% 44%, #000 52%, transparent 100%);
  }
  .si__grid :global(.e) { color: var(--accent); }
  .si__grid :global(.e2) { color: var(--accent-strong); }
  .si__grid :global(.gun) { color: var(--accent-amber); }
  .si__grid :global(.shot) { color: var(--text-strong); }
  .si__grid :global(.bomb) { color: var(--brand-fault); }
  .si__grid :global(.hit) { color: var(--accent-amber); }

  .si__hud {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-l);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .si__hud [data-statdot] { color: var(--accent-strong); }
  @media (prefers-reduced-motion: no-preference) {
    .si__hud [data-statdot] { animation: si-blink 1s steps(1, end) infinite; }
  }
  @keyframes si-blink { 50% { opacity: 0.2; } }

  .si__hb,
  .si__over,
  .si__pad,
  .si__x {
    font-family: var(--font-mono);
  }
  .si__hb {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.7rem;
    height: 1.7rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--brand-steel) 45%, transparent);
    font-size: 0.66rem;
    color: var(--accent-amber);
    z-index: 2;
  }
  .si__x {
    background: none;
    border: 0;
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
  }
  .si__x:hover { color: var(--text-strong); }

  .si__over {
    position: absolute;
    inset: 1.7rem 0 0 0;
    z-index: 3;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.4rem;
    background: color-mix(in srgb, var(--brand-void) 80%, transparent);
  }
  .si__over-t { color: var(--brand-fault); font-size: 1rem; }
  .si__over-s { color: var(--text); font-size: 0.85rem; }
  .si__over-h { color: var(--text-faint); font-size: 0.68rem; }
  .si__over kbd {
    font: inherit;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    padding: 0 0.25rem;
  }

  .si__pad {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem;
  }
  .si__pad button {
    width: 3.2rem;
    height: 2.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--brand-steel) 70%, transparent);
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }
  .si__pad button:active {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  .si__backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--brand-void) 92%, transparent);
    backdrop-filter: blur(2px);
    pointer-events: auto;
    cursor: pointer;
  }

  /* --- OYUN MODU --- */
  .si--playing {
    z-index: var(--z-nav-overlay);
  }
  .si--playing .si__backdrop { z-index: 1; }
  .si--playing .si__stage {
    position: fixed;
    inset: 0;
    margin: auto;
    z-index: 2;
    width: min(94vw, 600px);
    height: min(80vh, 500px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--brand-void) 96%, transparent);
    box-shadow: 0 0 0 1px var(--border-strong), 0 30px 80px -20px #000;
    pointer-events: auto;
    place-items: center;
  }
  .si--playing .si__grid {
    opacity: 1;
    color: color-mix(in srgb, var(--text) 92%, var(--brand-void));
    mask-image: none;
    -webkit-mask-image: none;
    margin-top: 0.85rem;
  }
  .si--playing .si__hud { display: none; }

  @media (pointer: fine) {
    .si--playing .si__pad { display: none !important; }
  }
  @media (max-width: 48rem) {
    .si:not(.si--playing) .si__hud { display: none; }
    /* mobilde metinle daha az boğuşsun */
    .si:not(.si--playing) .si__grid { opacity: 0.15; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-si-root]');
  const el = document.querySelector<HTMLPreElement>('[data-si]');
  const stage = document.querySelector<HTMLElement>('[data-stage]');

  if (root && el && stage) {
    const rootEl = root;
    const grid = el;
    const stageEl = stage;

    const waveOut = document.querySelector<HTMLElement>('[data-wave]');
    const scoreOut = document.querySelector<HTMLElement>('[data-score]');
    const statLabel = document.querySelector<HTMLElement>('[data-statlabel]');
    const over = document.querySelector<HTMLElement>('[data-over]');
    const overTitle = document.querySelector<HTMLElement>('[data-over-title]');
    const overScore = document.querySelector<HTMLElement>('[data-over-score]');
    const pad = document.querySelector<HTMLElement>('[data-pad]');
    const hb = document.querySelector<HTMLElement>('[data-hb]');
    const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
    const closeBtn = document.querySelector<HTMLElement>('[data-close]');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const COLS = 40;
    const ROWS = 16;
    const GUN_ROW = ROWS - 1;
    const EN_COLS = 8;
    const EN_ROWS = 4;
    const GAP_X = 4;
    const GAP_Y = 2;
    const FRAMES = [
      ['/', 'M', '\\'],
      ['\\', 'M', '/'],
    ];
    const GUN = ['/', '^', '\\'];
    const HS_KEY = 'si-highscore';

    type Mode = 'ambient' | 'play' | 'over';
    let mode: Mode = 'ambient';
    const isOver = () => mode === 'over';

    let alive: boolean[][];
    let fleet: { x: number; y: number; dir: number };
    const gun = { x: (COLS >> 1) - 1 };
    let shots: { x: number; y: number }[] = [];
    let bombs: { x: number; y: number }[] = [];
    let hits: { x: number; y: number; t: number }[] = [];
    let wave = 1;
    let score = 0;
    let lives = 3;
    let tick = 0;
    let cooldown = 0;
    let flash = 0;
    const input = { left: false, right: false, fire: false };
    let highScore = 0;
    try { highScore = Number(localStorage.getItem(HS_KEY)) || 0; } catch {}

    function spawn() {
      alive = Array.from({ length: EN_ROWS }, () => Array(EN_COLS).fill(true));
      fleet = { x: 3, y: 1, dir: 1 };
      shots = [];
      bombs = [];
    }
    function resetGame() {
      spawn();
      wave = 1;
      score = 0;
      lives = 3;
      gun.x = (COLS >> 1) - 1;
    }
    spawn();

    const enemyX = (c: number) => fleet.x + c * GAP_X;
    const enemyY = (r: number) => fleet.y + r * GAP_Y;
    const countAlive = () => alive.flat().filter(Boolean).length;

    function bounds() {
      let min = Infinity, max = -Infinity, maxY = -Infinity;
      for (let r = 0; r < EN_ROWS; r++)
        for (let c = 0; c < EN_COLS; c++)
          if (alive[r][c]) {
            min = Math.min(min, enemyX(c));
            max = Math.max(max, enemyX(c) + 2);
            maxY = Math.max(maxY, enemyY(r));
          }
      return { min, max, maxY };
    }

    function tryFire() {
      if (cooldown === 0 && shots.length < (mode === 'play' ? 3 : 2)) {
        shots.push({ x: gun.x + 1, y: GUN_ROW - 1 });
        cooldown = mode === 'play' ? 2 : 3;
      }
    }
    function loseLife() {
      lives--;
      flash = 4;
      bombs = [];
      if (lives <= 0) endGame();
    }
    function endGame() {
      mode = 'over';
      if (score > highScore) {
        highScore = score;
        try { localStorage.setItem(HS_KEY, String(score)); } catch {}
      }
      if (overTitle) overTitle.textContent = 'game over';
      if (overScore) overScore.textContent = `score ${score}  ·  best ${highScore}`;
      over?.removeAttribute('hidden');
    }

    function step() {
      tick++;
      if (cooldown > 0) cooldown--;
      if (flash > 0) flash--;

      const n = countAlive();
      if (n === 0) { wave++; score += 100; spawn(); return; }

      if (bounds().maxY >= GUN_ROW - 1) {
        if (mode === 'play') { loseLife(); if (isOver()) return; spawn(); }
        else { spawn(); return; }
      }

      const moveEvery = Math.max(1, Math.round(n / 6) + (mode === 'play' ? 1 : 0));
      if (tick % moveEvery === 0) {
        const b = bounds();
        if ((fleet.dir > 0 && b.max >= COLS - 1) || (fleet.dir < 0 && b.min <= 0)) {
          fleet.dir *= -1;
          fleet.y += 1;
        } else {
          fleet.x += fleet.dir;
        }
      }

      if (mode === 'play') {
        if (input.left) gun.x--;
        if (input.right) gun.x++;
        gun.x = Math.max(0, Math.min(COLS - 3, gun.x));
        if (input.fire) tryFire();
      } else {
        let targetX = gun.x, best = Infinity;
        for (let c = 0; c < EN_COLS; c++)
          for (let r = EN_ROWS - 1; r >= 0; r--)
            if (alive[r][c]) {
              const ex = enemyX(c) + 1;
              if (Math.abs(ex - (gun.x + 1)) < best) { best = Math.abs(ex - (gun.x + 1)); targetX = ex - 1; }
              break;
            }
        gun.x += Math.sign(targetX - gun.x);
        gun.x = Math.max(0, Math.min(COLS - 3, gun.x));
        if (best < 2) tryFire();
      }

      shots = shots.filter((s) => {
        s.y -= 1;
        if (s.y < 0) return false;
        for (let r = 0; r < EN_ROWS; r++)
          for (let c = 0; c < EN_COLS; c++)
            if (alive[r][c]) {
              const ex = enemyX(c), ey = enemyY(r);
              if (s.y === ey && s.x >= ex && s.x <= ex + 2) {
                alive[r][c] = false;
                score += 20;
                hits.push({ x: ex + 1, y: ey, t: 3 });
                return false;
              }
            }
        return true;
      });

      const bombChance = mode === 'play' ? 0.14 : 0.06;
      if (Math.random() < bombChance && bombs.length < (mode === 'play' ? 4 : 2)) {
        const cols: number[] = [];
        for (let c = 0; c < EN_COLS; c++) if (alive.some((row) => row[c])) cols.push(c);
        if (cols.length) {
          const c = cols[(Math.random() * cols.length) | 0];
          let br = 0;
          for (let r = EN_ROWS - 1; r >= 0; r--) if (alive[r][c]) { br = r; break; }
          bombs.push({ x: enemyX(c) + 1, y: enemyY(br) + 1 });
        }
      }
      bombs = bombs.filter((b) => {
        b.y += 1;
        if (mode === 'play' && b.y >= GUN_ROW && b.x >= gun.x && b.x <= gun.x + 2) {
          loseLife();
          return false;
        }
        return b.y < ROWS;
      });

      hits = hits.filter((h) => --h.t > 0);
    }

    function render() {
      const buf: string[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(' '));
      const cls: (string | null)[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(null));
      const put = (r: number, c: number, ch: string, k: string) => {
        if (r < 0 || c < 0 || r >= ROWS || c >= COLS) return;
        buf[r][c] = ch;
        cls[r][c] = k;
      };

      // ambient: boş hücrelere seyrek "veri" dokusu (statik karede bile dolu görünür)
      if (mode === 'ambient') {
        const NOISE = '.:-';
        for (let i = 0; i < ROWS * COLS; i++) {
          const rr = (i / COLS) | 0;
          const cc = i % COLS;
          const v = Math.sin(cc * 12.9898 + rr * 78.233 + tick * 0.05) * 43758.5453;
          if (v - Math.floor(v) > 0.972) buf[rr][cc] = NOISE[(cc + rr) % NOISE.length];
        }
      }

      const shape = FRAMES[tick % 2];
      for (let r = 0; r < EN_ROWS; r++)
        for (let c = 0; c < EN_COLS; c++) {
          if (!alive[r][c]) continue;
          const ex = enemyX(c), ey = enemyY(r);
          const kind = r === 0 ? 'e2' : 'e';
          for (let i = 0; i < 3; i++) put(ey, ex + i, shape[i], kind);
        }
      for (const h of hits) {
        put(h.y, h.x - 1, '*', 'hit');
        put(h.y, h.x + 1, '*', 'hit');
        put(h.y, h.x, '+', 'hit');
      }
      for (const b of bombs) put(b.y, b.x, tick % 2 ? '¦' : ':', 'bomb');
      for (const s of shots) put(s.y, s.x, '|', 'shot');
      if (flash % 2 === 0) for (let i = 0; i < 3; i++) put(GUN_ROW, gun.x + i, GUN[i], 'gun');

      let html = '';
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const k = cls[r][c];
          html += k ? `<span class="${k}">${buf[r][c]}</span>` : buf[r][c];
        }
        html += '\n';
      }
      grid.innerHTML = html;

      if (waveOut) waveOut.textContent = `wave ${wave} · ♥${Math.max(lives, 0)} · ${score}`;
      if (scoreOut) scoreOut.textContent = String(score);
      if (statLabel) statLabel.textContent = mode === 'ambient' ? 'simulating' : 'live';
    }

    // --- fit: ambient = hero'nun büyük kısmını doldur; play = çerçeveye sığdır ---
    function fit() {
      grid.style.setProperty('--k', '1');
      const gw = grid.offsetWidth || 1;
      const ghh = grid.offsetHeight || 1;
      let k: number;
      if (mode === 'ambient') {
        const w = rootEl.clientWidth * 0.94;
        const h = rootEl.clientHeight * 0.88;
        k = Math.min(w / gw, h / ghh, 3.6);
      } else {
        k = Math.min((stageEl.clientWidth - 24) / gw, (stageEl.clientHeight - 40) / ghh, 2.2);
      }
      grid.style.setProperty('--k', String(Math.max(0.5, k)));
    }
    let fitTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(fitTimer);
      fitTimer = window.setTimeout(fit, 150);
    });

    // --- mod geçişleri ---
    function enterPlay() {
      if (mode !== 'ambient') return;
      mode = 'play';
      resetGame();
      rootEl.classList.add('si--playing');
      backdrop?.removeAttribute('hidden');
      hb?.removeAttribute('hidden');
      pad?.removeAttribute('hidden');
      over?.setAttribute('hidden', '');
      document.documentElement.style.overflow = 'hidden';
      if (!loopRunning) startLoop();
      fit();
      setTimeout(fit, 60);
      requestAnimationFrame(() => { fit(); stageEl.focus?.(); });
    }
    function exitPlay() {
      mode = 'ambient';
      rootEl.classList.remove('si--playing');
      backdrop?.setAttribute('hidden', '');
      hb?.setAttribute('hidden', '');
      pad?.setAttribute('hidden', '');
      over?.setAttribute('hidden', '');
      document.documentElement.style.overflow = '';
      spawn();
      fit();
      setTimeout(fit, 60);
    }
    function retry() {
      mode = 'play';
      resetGame();
      over?.setAttribute('hidden', '');
    }

    // dış tetikleyiciler: [data-si-play] tıklaması + "P" tuşu
    document.querySelectorAll<HTMLElement>('[data-si-play]').forEach((b) =>
      b.addEventListener('click', (e) => { e.preventDefault(); enterPlay(); }),
    );
    closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); exitPlay(); });
    backdrop?.addEventListener('click', exitPlay);
    over?.addEventListener('click', () => { if (mode === 'over') retry(); });

    const KEYMAP: Record<string, 'left' | 'right' | 'fire'> = {
      ArrowLeft: 'left', a: 'left', A: 'left',
      ArrowRight: 'right', d: 'right', D: 'right',
      ArrowUp: 'fire', ' ': 'fire', w: 'fire', W: 'fire',
    };
    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      if (mode === 'ambient') {
        if ((e.key === 'p' || e.key === 'P') && tag !== 'INPUT' && tag !== 'TEXTAREA') enterPlay();
        return;
      }
      if (e.key === 'Escape') { exitPlay(); return; }
      if (mode === 'over' && (e.key === ' ' || e.key === 'Enter')) { e.preventDefault(); retry(); return; }
      const a = KEYMAP[e.key];
      if (a) { input[a] = true; e.preventDefault(); }
    });
    window.addEventListener('keyup', (e) => {
      const a = KEYMAP[e.key];
      if (a) input[a] = false;
    });

    pad?.querySelectorAll<HTMLElement>('[data-btn]').forEach((btn) => {
      const key = btn.dataset.btn as 'left' | 'right' | 'fire';
      const set = (v: boolean) => (e: Event) => {
        e.preventDefault();
        if (mode === 'over' && v) { retry(); return; }
        input[key] = v;
      };
      btn.addEventListener('pointerdown', set(true));
      btn.addEventListener('pointerup', set(false));
      btn.addEventListener('pointerleave', set(false));
      btn.addEventListener('pointercancel', set(false));
    });

    // --- döngü ---
    let loopRunning = false;
    let last = 0;
    function loop(ts: number) {
      const interval = mode === 'ambient' ? 150 : 55;
      if (ts - last > interval) {
        last = ts;
        if (mode !== 'over') step();
        render();
      }
      if (!document.hidden) requestAnimationFrame(loop);
      else setTimeout(() => requestAnimationFrame(loop), 500);
    }
    function startLoop() {
      loopRunning = true;
      requestAnimationFrame(loop);
    }

    render();
    fit();
    document.fonts?.ready.then(fit);
    if (!reduce) startLoop();
  }
</script>
