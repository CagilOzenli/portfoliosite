---
/**
 * YouTube gömülü oynatıcı — SADECE video ID alır.
 * Performans: önce thumbnail + ortalanmış play ikonu; tıklayınca <iframe>
 * lazy-load ile yüklenip otomatik oynar. Embed domaini: youtube-nocookie.com.
 * 16:9 responsive. (VideoEmbed.astro tam URL alır; bu ID-özel kısayoldur.)
 */
import Icon from './Icon.astro';

interface Props {
  videoId: string;
  title?: string;
}
const { videoId, title = 'Video' } = Astro.props;

const id = videoId.trim();
const poster = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const embedSrc = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
---

<div class="yt" data-yt data-embed={embedSrc} data-title={title} style={`--poster: url("${poster}")`}>
  <button type="button" class="yt__btn" data-yt-play>
    <span class="yt__play" aria-hidden="true">
      <Icon name="play" size={24} />
    </span>
    <span class="visually-hidden">Play video: {title}</span>
  </button>
</div>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background:
      var(--poster, none) center / cover no-repeat,
      var(--bg-elevated);
  }
  .yt::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 60%, transparent),
      color-mix(in srgb, var(--bg) 15%, transparent)
    );
    pointer-events: none;
  }
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt__btn {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .yt__play {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding-left: 4px;
    border-radius: 50%;
    color: var(--text);
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    border: 1px solid var(--border-strong);
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }
  .yt__btn:hover .yt__play,
  .yt__btn:focus-visible .yt__play {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent-deep) 65%, transparent);
  }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-yt]')) {
    const btn = el.querySelector<HTMLButtonElement>('[data-yt-play]');
    btn?.addEventListener(
      'click',
      () => {
        const src = el.dataset.embed;
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = el.dataset.title || 'Video';
        iframe.loading = 'lazy';
        iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture; clipboard-write';
        iframe.setAttribute('allowfullscreen', '');
        el.replaceChildren(iframe);
      },
      { once: true },
    );
  }
</script>
