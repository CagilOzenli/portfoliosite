---
/**
 * DENEY (terminal) — sticky terminal nav bar. Hamburger yok.
 * Tüm öğeler düz metin link (kapsül yok). Dar ekranda çubuk yatay kaydırılır.
 */
import { getNavigation } from '../lib/content';

const nav = await getNavigation();
const current = (Astro.url.pathname.replace(/\/+$/, '') || '/').toLowerCase();

function isActive(path: string) {
  const p = path.replace(/\/+$/, '') || '/';
  if (p === '/') return current === '/';
  return current === p || current.startsWith(p + '/');
}
---

<header class="bar">
  <nav class="bar__inner" aria-label="Primary">
    <a href="/" class="bar__brand">~/cagil</a>
    <ul class="bar__list">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.path}
              class="bar__item"
              aria-current={isActive(item.path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }
  .bar__inner {
    max-width: var(--container);
    margin-inline: auto;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-m);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .bar__inner::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 48rem) {
    .bar__inner {
      gap: var(--space-s);
      -webkit-mask-image: linear-gradient(to right, #000 90%, transparent);
      mask-image: linear-gradient(to right, #000 90%, transparent);
    }
  }

  .bar__brand {
    flex: none;
    font-size: var(--text--1);
    color: var(--text-muted);
  }
  .bar__brand:hover {
    color: var(--accent);
  }

  .bar__list {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-left: auto;
  }
  .bar__list li {
    flex: none;
  }

  .bar__item {
    display: inline-block;
    font-size: var(--text--1);
    color: var(--accent);
    white-space: nowrap;
  }
  .bar__item:hover {
    color: var(--link-hover);
  }
  .bar__item[aria-current='page'] {
    color: var(--text-strong);
  }
  .bar__item[aria-current='page']::before {
    content: '> ';
    color: var(--accent-amber);
  }
</style>
