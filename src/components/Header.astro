---
/**
 * DENEY (Midjourney) — sticky terminal nav bar. Hamburger yok.
 * Tam genişlik steel-navy çubuk; düz metin linkler + "specimen" pill butonlar.
 * Dar ekranda çubuk yatay kaydırılır.
 */
import { getNavigation } from '../lib/content';

const nav = await getNavigation();
const current = (Astro.url.pathname.replace(/\/+$/, '') || '/').toLowerCase();

function isActive(path: string) {
  const p = path.replace(/\/+$/, '') || '/';
  if (p === '/') return current === '/';
  return current === p || current.startsWith(p + '/');
}

// Pill olarak gösterilecek yollar; gerisi düz link
const PILL: Record<string, 'green' | 'amber'> = {
  '/cv': 'amber',
  '/contact': 'green',
};
---

<header class="bar">
  <nav class="bar__inner" aria-label="Primary">
    <a href="/" class="bar__brand">~/cagil</a>
    <ul class="bar__list">
      {
        nav.map((item) => {
          const pill = PILL[item.path];
          return (
            <li>
              <a
                href={item.path}
                class:list={['bar__item', pill && `bar__pill bar__pill--${pill}`]}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }
  .bar__inner {
    max-width: var(--container);
    margin-inline: auto;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-m);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .bar__inner::-webkit-scrollbar {
    display: none;
  }
  /* Dar ekranda sağ kenarda "devamı var" ipucu */
  @media (max-width: 48rem) {
    .bar__inner {
      gap: var(--space-s);
      -webkit-mask-image: linear-gradient(to right, #000 90%, transparent);
      mask-image: linear-gradient(to right, #000 90%, transparent);
    }
  }

  .bar__brand {
    flex: none;
    font-size: var(--text--1);
    color: var(--text-muted);
  }
  .bar__brand:hover {
    color: var(--accent);
  }

  .bar__list {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-left: auto;
  }
  .bar__list li {
    flex: none;
  }

  .bar__item {
    display: inline-block;
    font-size: var(--text--1);
    color: var(--accent);
    white-space: nowrap;
  }
  .bar__item:hover {
    color: var(--link-hover);
  }
  .bar__item[aria-current='page'] {
    color: var(--text-strong);
  }

  /* specimen pill butonlar */
  .bar__pill {
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-sm);
  }
  .bar__pill--green {
    background: color-mix(in srgb, var(--brand-specimen) 18%, transparent);
    color: var(--brand-specimen);
  }
  .bar__pill--green:hover {
    background: color-mix(in srgb, var(--brand-specimen) 28%, transparent);
    color: var(--brand-specimen);
  }
  .bar__pill--amber {
    background: color-mix(in srgb, var(--brand-amber) 16%, transparent);
    color: var(--brand-amber);
  }
  .bar__pill--amber:hover {
    background: color-mix(in srgb, var(--brand-amber) 26%, transparent);
    color: var(--brand-amber);
  }
  .bar__pill[aria-current='page'] {
    outline: 1px solid currentColor;
  }
</style>
