---
/**
 * DENEY (Midjourney) — bölüm başlığı: küçük amber glif + 30px mono etiket,
 * aynı satırda, weight 400. "Başlıklar bağırmaz."
 * `kicker` metni glife eşlenir (yoksa jenerik glif).
 */
interface Props {
  kicker?: string;
  title: string;
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  align?: 'start' | 'center';
}

const { kicker, title, as: Tag = 'h2', id, align = 'start' } = Astro.props;

const GLYPHS: Record<string, string> = {
  about: 'ℹ',
  work: '⚙',
  'selected work': '⚙',
  'systems lab': '⬡',
  contact: '✉',
  cv: '▤',
};
const glyph = GLYPHS[(kicker ?? title).toLowerCase()] ?? '▚';
---

<header class:list={['sh', `sh--${align}`]}>
  <div class="sh__row">
    <span class="sh__glyph" aria-hidden="true">{glyph}</span>
    <Tag id={id} class="sh__title">{title}</Tag>
  </div>
  {
    Astro.slots.has('default') && (
      <div class="sh__lead">
        <slot />
      </div>
    )
  }
</header>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-l);
  }
  .sh--center {
    align-items: center;
    text-align: center;
  }
  .sh__row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }
  .sh__glyph {
    flex: none;
    font-size: var(--text-0);
    color: var(--accent-amber);
    transform: translateY(-0.05em);
  }
  .sh__title {
    font-size: var(--text-3);
    font-weight: var(--weight-normal);
  }
  .sh__lead {
    max-width: 60ch;
    color: var(--text-muted);
  }
  .sh--center .sh__row {
    justify-content: center;
  }
</style>
