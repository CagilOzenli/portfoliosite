---
/**
 * Bağlantı butonu (site statik olduğu için hep <a>).
 * variant: 'primary' (dolu teal) | 'ghost' (çerçeveli)
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  icon?: 'arrow' | 'download' | 'mail' | 'external';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', icon = 'arrow', external = false, class: className } = Astro.props;
const attrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class:list={['btn', `btn--${variant}`, className]} {...attrs}>
  <span><slot /></span>
  <Icon name={icon} size={18} />
</a>

<style>
  /* Referans: 9999px pill, translucent tinted bg (opak dolgu YOK),
     yumuşak çift gölge, JetBrains Mono 14px, düz metin. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    letter-spacing: 0;
    text-transform: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-sm);
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }
  .btn :global(svg) {
    transition: transform var(--transition);
  }
  .btn:hover :global(svg) {
    transform: translateX(3px);
  }

  /* Birincil: specimen-green tenti */
  .btn--primary {
    background: color-mix(in srgb, var(--accent-strong) 18%, transparent);
    color: var(--accent-strong);
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent-strong) 28%, transparent);
  }

  /* İkincil: portal-blue tenti */
  .btn--ghost {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .btn--ghost:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
</style>
