---
/**
 * DENEY (terminal) — tam ekran koyu hero.
 * Arka plan = hero'yu kaplayan ASCII Space Invaders (AsciiHero) — soluk, tıklanamaz.
 * Header'ın hemen altında küçük bir "▶ play" easter-egg tetikleyicisi.
 */
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
import AsciiHero from './AsciiHero.astro';
import { getHero, getSiteSettings, getContact } from '../lib/content';

const [hero, settings, contact] = await Promise.all([
  getHero(),
  getSiteSettings(),
  getContact(),
]);

const linkedin = contact.linkedin || settings.social.linkedin;
const github = contact.github || settings.social.github;
const email = contact.email || settings.social.email;
---

<section class="hero">
  <AsciiHero />

  <button type="button" class="hero__egg" data-si-play>
    <span class="hero__egg-badge" aria-hidden="true">
      <svg class="hero__egg-i" width="9" height="11" viewBox="0 0 9 11">
        <path d="M0 0l9 5.5L0 11z" fill="currentColor" />
      </svg>
    </span>
    <span class="hero__egg-label">
      <span class="hero__egg-play">play</span>
      <span class="hero__egg-note">
        <span class="hero__egg-long">the background is </span>playable<span class="hero__egg-long"> — space invaders</span>
      </span>
    </span>
  </button>

  <div class="hero__inner container">
    <p class="hero__eyebrow">// portfolio</p>
    <h1 class="hero__name">{hero.name}<span class="hero__caret" aria-hidden="true">▮</span></h1>
    <p class="hero__role">{hero.role}</p>
    <p class="hero__tagline">{hero.tagline}</p>

    <div class="hero__actions">
      <Button href="/work" icon="arrow">{hero.ctaLabel}</Button>
    </div>

    <div class="hero__social">
      <SocialLinks linkedin={linkedin} github={github} email={email} variant="row" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding-block: var(--space-2xl) var(--section-gap);
    border-bottom: 1px solid var(--border);
  }

  /*
   * Header'ın hemen altında, oynanabilir olduğunu belli eden bir "rozet"
   * — düz metin linkiyle karışmasın diye kenarlık/arka plan + hafif
   * nabız animasyonlu play ikonu.
   */
  .hero__egg {
    position: absolute;
    top: var(--space-s);
    left: var(--gutter);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem 0.3rem 0.3rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
    backdrop-filter: blur(3px);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--accent);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .hero__egg:hover,
  .hero__egg:focus-visible {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--bg-elevated) 92%, transparent);
    transform: translateY(-1px);
  }
  .hero__egg-badge {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent-amber) 22%, transparent);
  }
  .hero__egg-i {
    color: var(--accent-amber);
    /* SVG optik olarak sola kaymış görünüyor — ortala */
    transform: translateX(1px);
  }
  .hero__egg-badge::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--accent-amber);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__egg-badge::after {
      animation: egg-pulse 2.6s ease-out infinite;
    }
  }
  @keyframes egg-pulse {
    0% { opacity: 0.55; transform: scale(0.85); }
    70%, 100% { opacity: 0; transform: scale(1.55); }
  }
  .hero__egg-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45ch;
  }
  .hero__egg-play {
    color: var(--text-strong);
    font-weight: var(--weight-bold);
  }
  .hero__egg-note {
    color: var(--text-faint);
  }
  .hero__egg:hover .hero__egg-note {
    color: var(--text-muted);
  }
  @media (max-width: 34rem) {
    .hero__egg-long { display: none; }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__eyebrow {
    font-size: var(--text--1);
    color: var(--accent-amber);
    margin-bottom: var(--space-s);
  }

  .hero__name {
    font-size: var(--text-4);
    line-height: 1.15;
    font-weight: var(--weight-normal);
    color: var(--text-strong);
  }
  .hero__caret {
    display: inline-block;
    margin-left: 0.12em;
    color: var(--accent);
    transform: translateY(-0.04em);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__caret {
      animation: caret-blink 1.1s steps(1, end) infinite;
    }
  }
  @keyframes caret-blink {
    50% { opacity: 0; }
  }
  .hero__role {
    margin-top: var(--space-2xs);
    font-size: var(--text-1);
    color: var(--accent);
  }
  .hero__tagline {
    margin-top: var(--space-m);
    font-size: var(--text-0);
    color: var(--text);
    max-width: 44ch;
  }
  .hero__actions {
    margin-top: var(--space-l);
  }
  .hero__social {
    /* "View Work" ile linkler arası — 48 çok, 0 az; ~40px ortası */
    margin-top: 2.5rem;
  }

  @media (max-width: 61.99rem) {
    .hero {
      min-height: 78svh;
      padding-block: var(--space-2xl) var(--section-gap);
    }
  }
</style>
