---
/**
 * DENEY (Midjourney) — tam ekran koyu hero.
 * Görsel = ASCII generative küre (AsciiHero). Üstünde isim / rol / tagline /
 * "View Work" pill + sosyal linkler. Fotoğraf/greybox kullanılmıyor.
 */
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
import AsciiHero from './AsciiHero.astro';
import { getHero, getSiteSettings, getContact } from '../lib/content';

const [hero, settings, contact] = await Promise.all([
  getHero(),
  getSiteSettings(),
  getContact(),
]);

const linkedin = contact.linkedin || settings.social.linkedin;
const github = contact.github || settings.social.github;
const email = contact.email || settings.social.email;
---

<section class="hero">
  <AsciiHero />

  <div class="hero__inner container">
    <p class="hero__eyebrow">// portfolio</p>
    <h1 class="hero__name">{hero.name}<span class="hero__caret" aria-hidden="true">▮</span></h1>
    <p class="hero__role">{hero.role}</p>
    <p class="hero__tagline">{hero.tagline}</p>

    <div class="hero__actions">
      <Button href="/work" icon="arrow">{hero.ctaLabel}</Button>
    </div>

    <SocialLinks
      class="hero__social"
      linkedin={linkedin}
      github={github}
      email={email}
      variant="row"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding-block: var(--space-2xl) var(--section-gap);
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__eyebrow {
    font-size: var(--text--1);
    color: var(--accent-amber);
    margin-bottom: var(--space-s);
  }

  .hero__name {
    font-size: var(--text-4);
    line-height: 1.15;
    font-weight: var(--weight-normal);
    color: var(--text-strong);
  }
  .hero__caret {
    display: inline-block;
    margin-left: 0.12em;
    color: var(--accent);
    transform: translateY(-0.04em);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__caret {
      animation: caret-blink 1.1s steps(1, end) infinite;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  .hero__role {
    margin-top: var(--space-2xs);
    font-size: var(--text-1);
    color: var(--accent);
  }
  .hero__tagline {
    margin-top: var(--space-m);
    font-size: var(--text-0);
    color: var(--text);
    max-width: 44ch;
  }
  .hero__actions {
    margin-top: var(--space-l);
  }
  .hero__social {
    margin-top: var(--space-l);
  }
</style>
